# Copy to .env to override defaults. Nothing here is required: every model and dataset
# used is public (Llama via Ollama, Laya and TruthfulQA via HuggingFace).

# Optional: HuggingFace token, only to avoid anonymous rate limits on downloads
HF_TOKEN=

# Generator (Ollama). docker compose sets OLLAMA_URL itself; this is for host runs.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Judge (Laya). Subfolder: "" (English), "multilingual", "typed-decisions"
LAYA_MODEL=convaiinnovations/laya
LAYA_SUBFOLDER=
LAYA_DEVICE=

# Experiment
POC_SAMPLES=50
POC_TRIALS=5
POC_SEED=42
POC_TEMPERATURE=0.7
POC_MAX_TOKENS=96
